{
  "extends": "@yuu1111/tsconfig",
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES6",
    "allowJs": true,
    "strict": false,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": false,
    "importHelpers": false,
    "isolatedModules": true,
    "strictNullChecks": true,
    "types": [
      "bun",
      "node"
    ],
    "lib": [
      "DOM",
      "ES2020"
    ]
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
